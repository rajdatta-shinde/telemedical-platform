# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Secret used to sign JWTs. Must be long and random (e.g. `openssl rand -hex 48`).
# The server refuses to start if this is missing or left at the insecure default.
JWT_SECRET=

# HTTP port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API (CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# Cloudinary credentials used to host uploaded images. Grab these from
# the Cloudinary dashboard. Without them, /upload will refuse to start.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=telemedical
